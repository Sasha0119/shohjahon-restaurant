# ─────────────────────────────────────────────────────────────────────────────
#  API environment. Copy to apps/api/.env and fill in.
#  NEVER commit the real .env — it's in .gitignore.
#  Generate secrets with:  openssl rand -base64 48
#  (or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
# true when requests arrive through a proxy (the Next.js /api rewrite, nginx, Caddy, a load balancer)
# so rate limits see the real client IP. Then the API port must NOT be reachable directly.
TRUST_PROXY=true

# PostgreSQL connection string
DATABASE_URL=postgresql://restaurant:restaurant@localhost:5432/restaurant?schema=public

# Web app origin(s) allowed to call the API (comma-separated, no trailing slash)
CORS_ORIGINS=http://localhost:3000
# Public URL of the guest app — printed QR codes point here
PUBLIC_WEB_URL=http://localhost:3000

# Security — use two DIFFERENT long random values. The API refuses example values in production.
QR_TOKEN_SECRET=change-me-qr-secret-at-least-32-characters-long
COOKIE_SECRET=change-me-cookie-secret-at-least-32-characters-long
# Must be true in production (HTTPS only cookies)
COOKIE_SECURE=false

# Only when the web server reaches this API over the internet (e.g. Render): set the same long
# random value on both services so each visitor gets their own rate limit. Leave empty behind Caddy.
INTERNAL_PROXY_SECRET=

# Table session expires after this many idle minutes
SESSION_IDLE_MINUTES=120
# Staff stay logged in for this many hours
STAFF_SESSION_HOURS=12
# Anti-spam: seconds between identical "Call server" requests from one table
CALL_COOLDOWN_SECONDS=60

# Bookings (with the guest's name and phone) are deleted this many days after their date
RESERVATION_RETENTION_DAYS=90

# Uploaded menu photos (served at /uploads). Must be a persistent volume in production.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Payments: "mock" (no real money) or "stripe"
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional — enables "Email my receipt"
SMTP_URL=
EMAIL_FROM=

# ── Seed only (npm run db:seed) ─────────────────────────────────────────────
# First manager account. Change the password after first login.
SEED_MANAGER_EMAIL=manager@example.com
SEED_MANAGER_PASSWORD=change-me-please-10+
# Demo PIN staff for local testing (leave empty to skip creating them)
SEED_DEMO_STAFF=true
