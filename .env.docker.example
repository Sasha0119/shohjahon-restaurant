# Copy to `.env` next to docker-compose.yml and replace EVERY value.
# Generate secrets with:  openssl rand -hex 32
# (Use hex — it is safe inside URLs, unlike some base64 characters.)

# Your domain (DNS A/AAAA record must point at this server). No https://, no slash.
DOMAIN=order.your-restaurant.com
# Let's Encrypt expiry notices.
ACME_EMAIL=you@your-restaurant.com

# Database (only reachable inside the Docker network).
POSTGRES_USER=restaurant
POSTGRES_PASSWORD=
POSTGRES_DB=restaurant
# The limited login the API runs as (POSTGRES_USER only runs migrations and the seed).
APP_DB_PASSWORD=

# Signing secrets — at least 32 characters, different from each other.
# Changing QR_TOKEN_SECRET invalidates every printed table QR code.
QR_TOKEN_SECRET=
COOKIE_SECRET=

LOG_LEVEL=info
SESSION_IDLE_MINUTES=120
STAFF_SESSION_HOURS=12
CALL_COOLDOWN_SECONDS=60
MAX_UPLOAD_MB=5

# Payments: "mock" (demo, no money moves) until the Stripe provider is connected.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: "email my receipt".
SMTP_URL=
EMAIL_FROM=

# First manager account (created by the seed command; change the password after first sign-in).
SEED_MANAGER_EMAIL=
SEED_MANAGER_PASSWORD=
# Demo PIN staff (Demo Waiter 1234 / Demo Kitchen 4321) — keep false in production.
SEED_DEMO_STAFF=false
